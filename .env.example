# ── Ravun — Ortam Değişkenleri ──
# Yerel geliştirme için bu dosyayı ".env" olarak kopyalayın.
# Vercel'de aynı değerleri: Proje → Settings → Environment Variables.
# ".env" asla Git'e yüklenmez.

# ── SUNUCU (gizli — tarayıcıya hiç gönderilmez) ──

# PostgreSQL bağlantı adresi. Vercel'de Neon entegrasyonu eklenince
# DATABASE_URL otomatik tanımlanır; elle girmenize gerek yoktur.
# VPS'te kendi Postgres'inizin adresini yazın.
DATABASE_URL=postgres://kullanici:sifre@localhost:5432/ravun

# Yönetim paneli PIN'i. En az 6 haneli, tahmin edilmesi zor bir değer seçin.
# (İsterseniz düz PIN yerine hash de verebilirsiniz:
#   ADMIN_PIN_HASH=$(node -e "console.log(require('crypto').createHash('sha256').update('ravun-local-admin-v2:PININIZ').digest('hex'))")
ADMIN_PIN=

# İsteğe bağlı: oturum imzalama anahtarı (uzun rastgele bir metin).
# Tanımlanmazsa PIN'den türetilir; PIN değişince açık oturumlar kapanır.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# İsteğe bağlı: Telegram bildirimleri. Normalde panelden (Bildirimler sayfası)
# ayarlanır; burada verilirse panelde ayar yoksa bunlar kullanılır.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# İsteğe bağlı: müşteriler için "Google ile giriş". İkisi de tanımlı değilse
# sitede giriş düğmesi görünmez. Kurulum: DURUM-VE-YAPILACAKLAR.md → Google ile giriş.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SİTE (herkese açık — tarayıcı koduna gömülür) ──

# WhatsApp sipariş/iletişim numarası (ülke kodu ile, boşluksuz — ör: 905XXXXXXXXX)
VITE_WHATSAPP_NUMBER=905375614967

# İletişim e-postası
VITE_CONTACT_EMAIL=atolye@ravun.com.tr

# Sitenin canlı adresi (SEO / paylaşım linkleri için)
VITE_SITE_URL=https://ravun-tau.vercel.app
