# ── Ravun Admin Paneli — Ortam Değişkenleri Örneği ──
# Bu dosyayı kopyalayıp ".env" olarak kaydet, sonra kendi değerlerini gir.
# ".env" dosyası gizli tutulmalı ve asla Git'e (public repoya) yüklenmemeli.

# ADMIN PIN HASH
# Admin paneline giriş için kullanılan PIN kodu kaynak kodda düz metin
# olarak SAKLANMAZ; yalnızca SHA-256 hash'i saklanır.
#
# Yeni bir PIN belirlemek için:
#   1) Aşağıdaki komutu, PININIZI yazarak terminalde çalıştırın (Node.js gerekir):
#
#      node -e "const c=require('crypto');console.log(c.createHash('sha256').update('ravun-local-admin-v2:PININIZ').digest('hex'))"
#
#   2) Çıkan hash değerini aşağıya yapıştırın.
#   3) Projeyi yeniden başlatın / yeniden deploy edin.
#
# NOT: "ravun-local-admin-v2:" ön eki (salt) sabittir, PIN'in önüne
# aynen bu şekilde eklenerek hash'lenir — komutu değiştirmeyin, sadece
# PININIZ kısmını kendi PIN'inizle değiştirin.
#
# Şu anki geçici PIN: 1234 (üretimde mutlaka daha güçlü bir PIN ile değiştirin)
VITE_ADMIN_PIN_HASH=32456b37e2f184491ff7824b906b0f04fd2327eb36f39c5c50bb7f241be9f061

# WhatsApp sipariş/iletişim numarası (ülke kodu ile, boşluksuz — ör: 905XXXXXXXXX)
VITE_WHATSAPP_NUMBER=905375614967

# İletişim e-postası
VITE_CONTACT_EMAIL=atolye@ravun.com.tr

# Sitenin canlı adresi (SEO / paylaşım linkleri için)
VITE_SITE_URL=https://ravun-tau.vercel.app
